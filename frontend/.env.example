# 复制成 .env.local 再填写（.env.local 已被 git 忽略）。
# 每个 Agent 角色都直接调用下面的模型接口（OpenAI 兼容），各自保留对话历史。
# 在浏览器里写流程的引擎通过 /api/llm/chat（src/llm/client.ts）调用同一个接口。

# OpenAI 兼容接口地址
ROUNDTABLE_API_BASE_URL=https://api.cline.bot/api/v1
# 接口密钥
ROUNDTABLE_API_KEY=
# 模型 id（以接口 /models 列表里的写法为准）
ROUNDTABLE_MODEL=cline-pass/deepseek-v4.1-flash
